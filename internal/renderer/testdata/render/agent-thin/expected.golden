---
apiVersion: v1
kind: Namespace
metadata:
  name: helpdesk-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: helpdesk
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:ded171270cb4e2fcbcc5d905e30e6f08b433bdf041706b14af2488f974d9ce79
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: api
  namespace: helpdesk-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: api
    kelson.dev/environment: production
    kelson.dev/project: helpdesk
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:de2ecc5159968cfe677a9f7aa40760d39a789a08691ad1e4404d8415fd4311a2
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: helpdesk-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: api
    kelson.dev/environment: production
    kelson.dev/project: helpdesk
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:de2ecc5159968cfe677a9f7aa40760d39a789a08691ad1e4404d8415fd4311a2
spec:
  selector:
    kelson.dev/project: helpdesk
    kelson.dev/component: api
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: helpdesk-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: api
    kelson.dev/environment: production
    kelson.dev/project: helpdesk
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:de2ecc5159968cfe677a9f7aa40760d39a789a08691ad1e4404d8415fd4311a2
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: helpdesk
      kelson.dev/component: api
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: api
        kelson.dev/environment: production
        kelson.dev/project: helpdesk
    spec:
      serviceAccountName: api
      containers:
        - name: api
          image: ghcr.io/acme/helpdesk:0.9.1
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: LOG_LEVEL
              value: info
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: triage
  namespace: helpdesk-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: triage
    kelson.dev/environment: production
    kelson.dev/project: helpdesk
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:6d1111b02b4c4d9de31855cff84a8ba2673f0658bb3336d4335bbd41cd59e2b4
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: triage
  namespace: helpdesk-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: triage
    kelson.dev/environment: production
    kelson.dev/project: helpdesk
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:6d1111b02b4c4d9de31855cff84a8ba2673f0658bb3336d4335bbd41cd59e2b4
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: helpdesk
      kelson.dev/component: triage
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: triage
        kelson.dev/environment: production
        kelson.dev/project: helpdesk
    spec:
      serviceAccountName: triage
      containers:
        - name: triage
          image: ghcr.io/acme/helpdesk:0.9.1
          command:
            - helpdesk
            - agent
            - triage
          env:
            - name: AGENT_ROLE
              value: triage
            - name: LOG_LEVEL
              value: info
