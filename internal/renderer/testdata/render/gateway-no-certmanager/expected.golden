---
apiVersion: v1
kind: Namespace
metadata:
  name: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:459efca4f7b11be6fe9ba102540cfa95a203ef8c272aea9861bd338aa8e8ba95
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:e0b7c9b9a4b79538fd3e67f01cf52f2f5fe71d32478cf73e0c475d983a70e556
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:e0b7c9b9a4b79538fd3e67f01cf52f2f5fe71d32478cf73e0c475d983a70e556
spec:
  selector:
    kelson.dev/project: shopfront
    kelson.dev/application: web
  ports:
    - name: http
      port: 3000
      targetPort: 3000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:e0b7c9b9a4b79538fd3e67f01cf52f2f5fe71d32478cf73e0c475d983a70e556
spec:
  replicas: 3
  selector:
    matchLabels:
      kelson.dev/project: shopfront
      kelson.dev/application: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: web
        kelson.dev/environment: production
        kelson.dev/project: shopfront
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: registry.acme.run/shopfront:3.1.0
          ports:
            - name: http
              containerPort: 3000
          resources:
            requests:
              cpu: 250m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 512Mi
          livenessProbe:
            httpGet:
              path: /up
              port: 3000
          readinessProbe:
            httpGet:
              path: /up
              port: 3000
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: web
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:e0b7c9b9a4b79538fd3e67f01cf52f2f5fe71d32478cf73e0c475d983a70e556
spec:
  parentRefs:
    - name: public
  hostnames:
    - web.shop.acme.io
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: web
          port: 3000
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: images
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: images
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:2a327dfc660d19af221be680f7c3b35bd7962b1d459c10c52362d07bb96019c6
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: images
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: images
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:2a327dfc660d19af221be680f7c3b35bd7962b1d459c10c52362d07bb96019c6
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: shopfront
      kelson.dev/application: images
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: images
        kelson.dev/environment: production
        kelson.dev/project: shopfront
    spec:
      serviceAccountName: images
      containers:
        - name: images
          image: registry.acme.run/shopfront:3.1.0
          command:
            - shopfront
            - process-images
