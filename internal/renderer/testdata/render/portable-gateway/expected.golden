---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: portable-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: portable
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:e42d6c28a4fb0cea19994ce2340cf4e8a024d2ddf6e2f3df058b1ce50bcd92ab
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: portable-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: portable
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:e42d6c28a4fb0cea19994ce2340cf4e8a024d2ddf6e2f3df058b1ce50bcd92ab
spec:
  selector:
    kelson.dev/project: portable
    kelson.dev/application: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: portable-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: portable
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:e42d6c28a4fb0cea19994ce2340cf4e8a024d2ddf6e2f3df058b1ce50bcd92ab
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: portable
      kelson.dev/application: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: web
        kelson.dev/environment: production
        kelson.dev/project: portable
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/portable:v1
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: LOG_LEVEL
              value: info
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: web
  namespace: portable-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: portable
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:e42d6c28a4fb0cea19994ce2340cf4e8a024d2ddf6e2f3df058b1ce50bcd92ab
spec:
  parentRefs:
    - name: envoy
  hostnames:
    - web.portable.acme.run
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: web
          port: 8080
