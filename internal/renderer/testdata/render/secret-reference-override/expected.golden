---
apiVersion: v1
kind: Namespace
metadata:
  name: billing-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: billing
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:5d1429bbcc21bb6371863b1d7cd19025d06c7af86bcca75eadf61638f49d992a
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: api
  namespace: billing-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: api
    kelson.dev/environment: production
    kelson.dev/project: billing
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:ceff134b942ab05c77369eab756f7b3592a838ac32b75f9dd3cf9e38683e2b5e
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: billing-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: api
    kelson.dev/environment: production
    kelson.dev/project: billing
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:ceff134b942ab05c77369eab756f7b3592a838ac32b75f9dd3cf9e38683e2b5e
spec:
  selector:
    kelson.dev/project: billing
    kelson.dev/component: api
  ports:
    - name: http
      port: 9090
      targetPort: 9090
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: billing-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: api
    kelson.dev/environment: production
    kelson.dev/project: billing
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:ceff134b942ab05c77369eab756f7b3592a838ac32b75f9dd3cf9e38683e2b5e
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: billing
      kelson.dev/component: api
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: api
        kelson.dev/environment: production
        kelson.dev/project: billing
    spec:
      serviceAccountName: api
      containers:
        - name: api
          image: ghcr.io/acme/billing:3.1.0
          ports:
            - name: http
              containerPort: 9090
          env:
            - name: API_BASE_URL
              valueFrom:
                secretKeyRef:
                  name: billing-upstream
                  key: base-url
            - name: LOG_LEVEL
              value: debug
            - name: QUEUE_NAME
              value: billing-prod
