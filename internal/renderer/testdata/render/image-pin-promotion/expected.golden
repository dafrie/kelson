---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:eab93cfe641f7bc1221d1fed8245114c56e76771e2934e2f9a21c453c4196a77
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:4144c914ae5bdb0981be3da030707e434ffb46c829d81152ab2771d2efbb2c5f
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:4144c914ae5bdb0981be3da030707e434ffb46c829d81152ab2771d2efbb2c5f
spec:
  selector:
    kelson.dev/project: checkout
    kelson.dev/component: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:4144c914ae5bdb0981be3da030707e434ffb46c829d81152ab2771d2efbb2c5f
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: web
        kelson.dev/environment: production
        kelson.dev/project: checkout
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/checkout@sha256:9f6ad2c1b4d5e8073a1c2f4b6d8e0a1c3e5f7091b2d4c6e8a0f2b4d6c8e0a2f4
          ports:
            - name: http
              containerPort: 8080
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: worker
  namespace: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:397daa1e5f0b09ea52796ccf9e692eb8ed3a928cf86b01854986873ed9d39175
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:397daa1e5f0b09ea52796ccf9e692eb8ed3a928cf86b01854986873ed9d39175
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: worker
        kelson.dev/environment: production
        kelson.dev/project: checkout
    spec:
      serviceAccountName: worker
      containers:
        - name: worker
          image: ghcr.io/acme/checkout@sha256:9f6ad2c1b4d5e8073a1c2f4b6d8e0a1c3e5f7091b2d4c6e8a0f2b4d6c8e0a2f4
          command:
            - bundle
            - exec
            - sidekiq
