---
apiVersion: v1
kind: Namespace
metadata:
  name: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:25678253b0a562e792d329901cef96051b84c9059ea38e2702553aabf972083b
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: worker
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:2ac1ef9ec5f8f824937dd721c821189929eb8a11e0d2e935e7de9ea10e481434
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:2ac1ef9ec5f8f824937dd721c821189929eb8a11e0d2e935e7de9ea10e481434
spec:
  replicas: 2
  selector:
    matchLabels:
      kelson.dev/project: mailroom
      kelson.dev/application: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: worker
        kelson.dev/environment: production
        kelson.dev/project: mailroom
    spec:
      serviceAccountName: worker
      containers:
        - name: worker
          image: registry.acme.run/mailroom:2.0.7
          command:
            - mailroom
            - work
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: digest
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: digest
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:1b2c34850b336d8ac7e1545c0773af49865c65cd0c45149b07e71e09bc296ad8
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: digest
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: digest
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:1b2c34850b336d8ac7e1545c0773af49865c65cd0c45149b07e71e09bc296ad8
spec:
  schedule: 30 6 * * 1-5
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/application: digest
            kelson.dev/environment: production
            kelson.dev/project: mailroom
        spec:
          serviceAccountName: digest
          restartPolicy: Never
          containers:
            - name: digest
              image: registry.acme.run/mailroom:2.0.7
              command:
                - mailroom
                - send-digests
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: retention-sweep
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: retention-sweep
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:ec82651cd42b2feff0ad58ba3d03696141354d9bbc640757c324688efef14990
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: retention-sweep
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: retention-sweep
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:ec82651cd42b2feff0ad58ba3d03696141354d9bbc640757c324688efef14990
spec:
  schedule: 15 2 * * *
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/application: retention-sweep
            kelson.dev/environment: production
            kelson.dev/project: mailroom
        spec:
          serviceAccountName: retention-sweep
          restartPolicy: Never
          containers:
            - name: retention-sweep
              image: registry.acme.run/mailroom:2.0.7
              command:
                - mailroom
                - sweep
                - --older-than=90d
