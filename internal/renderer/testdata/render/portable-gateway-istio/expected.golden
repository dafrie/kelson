---
apiVersion: v1
kind: Namespace
metadata:
  name: portable-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: portable
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:f5c1656b8cc44446df1e1b8d545152637c7d0bf799d0d991ee1e4f06df30735e
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: portable-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: portable
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:575d663d975388745e089a40211fbe8adbbb99a5394dcbcea88c9968d410adad
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: portable-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: portable
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:575d663d975388745e089a40211fbe8adbbb99a5394dcbcea88c9968d410adad
spec:
  selector:
    kelson.dev/project: portable
    kelson.dev/component: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: portable-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: portable
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:575d663d975388745e089a40211fbe8adbbb99a5394dcbcea88c9968d410adad
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: portable
      kelson.dev/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: web
        kelson.dev/environment: production
        kelson.dev/project: portable
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/portable:v1
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: LOG_LEVEL
              value: info
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: web
  namespace: portable-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: portable
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:575d663d975388745e089a40211fbe8adbbb99a5394dcbcea88c9968d410adad
spec:
  parentRefs:
    - name: istio
  hostnames:
    - web.portable.acme.run
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: web
          port: 8080
