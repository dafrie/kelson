---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:390d1e9fdf0a284bf9a6450928bd721e42fd79c0d49742a8a0246aa4effe0313
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bfc27404f3549cfb5a440ef69cd748efc503b65d2a8ea8e15ea8fd603bd2e417
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bfc27404f3549cfb5a440ef69cd748efc503b65d2a8ea8e15ea8fd603bd2e417
spec:
  selector:
    kelson.dev/project: checkout
    kelson.dev/component: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bfc27404f3549cfb5a440ef69cd748efc503b65d2a8ea8e15ea8fd603bd2e417
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: web
        kelson.dev/environment: staging
        kelson.dev/project: checkout
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/checkout:1.4.2
          ports:
            - name: http
              containerPort: 8080
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bfc27404f3549cfb5a440ef69cd748efc503b65d2a8ea8e15ea8fd603bd2e417
spec:
  parentRefs:
    - name: envoy
  hostnames:
    - web.staging.acme.run
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: web
          port: 8080
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: web-tls
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bfc27404f3549cfb5a440ef69cd748efc503b65d2a8ea8e15ea8fd603bd2e417
spec:
  secretName: web-tls
  issuerRef:
    kind: ClusterIssuer
    name: letsencrypt-prod
  dnsNames:
    - web.staging.acme.run
---
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSetInputProvider
metadata:
  name: checkout-staging-previews
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:1c9df18a9bd89c38444054045e743b1f95f6a661fa6d5aa7b2a7c0848948419b
    fluxcd.controlplane.io/reconcileEvery: 5m
spec:
  type: GitHubPullRequest
  url: https://github.com/acme/checkout
  secretRef:
    name: github-auth
  filter:
    labels:
      - deploy/preview
    includeBranch: ^feat/.*
    excludeBranch: ^wip/.*
    limit: 5
  skip:
    labels:
      - deploy/preview-pause
      - '!ci/passed'
---
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  name: checkout-staging-previews
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:1c9df18a9bd89c38444054045e743b1f95f6a661fa6d5aa7b2a7c0848948419b
spec:
  inputsFrom:
    - apiVersion: fluxcd.controlplane.io/v1
      kind: ResourceSetInputProvider
      name: checkout-staging-previews
  commonMetadata:
    labels:
      app.kubernetes.io/managed-by: kelson
      kelson.dev/environment: staging
      kelson.dev/project: checkout
  wait: true
  resourcesTemplate: |
    ---
    apiVersion: source.toolkit.fluxcd.io/v1beta2
    kind: OCIRepository
    metadata:
      name: checkout-staging-pr<< inputs.id >>
      namespace: checkout-staging
    spec:
      interval: 10m
      url: oci://ghcr.io/acme/checkout-previews
      ref:
        tag: << inputs.sha >>
      secretRef:
        name: ghcr-auth
    ---
    apiVersion: kustomize.toolkit.fluxcd.io/v1
    kind: Kustomization
    metadata:
      name: checkout-staging-pr<< inputs.id >>
      namespace: checkout-staging
    spec:
      interval: 10m
      prune: true
      wait: true
      targetNamespace: checkout-staging-pr<< inputs.id >>
      sourceRef:
        kind: OCIRepository
        name: checkout-staging-pr<< inputs.id >>
      path: ./
