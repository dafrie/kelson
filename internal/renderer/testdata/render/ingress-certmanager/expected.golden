---
apiVersion: v1
kind: Namespace
metadata:
  name: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:84f6393d01372945a0710db65b98ccbff1e45f6ed44e7ee65e56b75f91b5ecab
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:8f70450b5af36312a39859041648a2d81cafed494b6cd526b874d5f7ad95c869
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:8f70450b5af36312a39859041648a2d81cafed494b6cd526b874d5f7ad95c869
spec:
  selector:
    kelson.dev/project: hello
    kelson.dev/application: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:8f70450b5af36312a39859041648a2d81cafed494b6cd526b874d5f7ad95c869
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: hello
      kelson.dev/application: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: web
        kelson.dev/environment: staging
        kelson.dev/project: hello
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/hello:v1
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: GREETING
              value: hello
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: web
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:8f70450b5af36312a39859041648a2d81cafed494b6cd526b874d5f7ad95c869
spec:
  ingressClassName: nginx
  rules:
    - host: web.staging.acme.run
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: web
                port:
                  number: 8080
  tls:
    - hosts:
        - web.staging.acme.run
      secretName: web-tls
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: web-tls
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:8f70450b5af36312a39859041648a2d81cafed494b6cd526b874d5f7ad95c869
spec:
  secretName: web-tls
  issuerRef:
    kind: ClusterIssuer
    name: letsencrypt-prod
  dnsNames:
    - web.staging.acme.run
