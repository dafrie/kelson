---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:63d694e731f07cbc7a7a9b49755cc24854ff04cab16e6662e80f18ca0b9709a8
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:0657abd5cf89dd56e566c29bb02fb5ead0d598f2c514cfee5677cf8b6f9298a7
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:0657abd5cf89dd56e566c29bb02fb5ead0d598f2c514cfee5677cf8b6f9298a7
spec:
  selector:
    kelson.dev/project: checkout
    kelson.dev/component: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:0657abd5cf89dd56e566c29bb02fb5ead0d598f2c514cfee5677cf8b6f9298a7
spec:
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: web
        kelson.dev/environment: production
        kelson.dev/project: checkout
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/checkout:1.4.2
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: LOG_LEVEL
              value: warning
          resources:
            requests:
              cpu: 500m
              memory: 512Mi
            limits:
              memory: 1Gi
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:0657abd5cf89dd56e566c29bb02fb5ead0d598f2c514cfee5677cf8b6f9298a7
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: web
  minReplicas: 3
  maxReplicas: 20
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 80
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:0657abd5cf89dd56e566c29bb02fb5ead0d598f2c514cfee5677cf8b6f9298a7
spec:
  parentRefs:
    - name: envoy
  hostnames:
    - checkout.acme.com
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: web
          port: 8080
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: web-tls
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:0657abd5cf89dd56e566c29bb02fb5ead0d598f2c514cfee5677cf8b6f9298a7
spec:
  secretName: web-tls
  issuerRef:
    kind: ClusterIssuer
    name: letsencrypt-prod
  dnsNames:
    - checkout.acme.com
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:0657abd5cf89dd56e566c29bb02fb5ead0d598f2c514cfee5677cf8b6f9298a7
spec:
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/component: web
  endpoints:
    - port: http
      path: /metrics
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: worker
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:99413847faa486a5ad9d9d5f00a738001bab889afe0b191f7d5ebb3e9afdae0d
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:99413847faa486a5ad9d9d5f00a738001bab889afe0b191f7d5ebb3e9afdae0d
spec:
  replicas: 2
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: worker
        kelson.dev/environment: production
        kelson.dev/project: checkout
    spec:
      serviceAccountName: worker
      containers:
        - name: worker
          image: ghcr.io/acme/checkout:1.4.2
          command:
            - bundle
            - exec
            - sidekiq
          env:
            - name: LOG_LEVEL
              value: info
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: nightly-report
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: nightly-report
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:11a3263cca1424067f899adf8b51f120cd9f8edcec03b7647acf5c1f1f9619bf
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: nightly-report
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: nightly-report
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:11a3263cca1424067f899adf8b51f120cd9f8edcec03b7647acf5c1f1f9619bf
spec:
  schedule: 0 3 * * *
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/component: nightly-report
            kelson.dev/environment: production
            kelson.dev/project: checkout
        spec:
          serviceAccountName: nightly-report
          restartPolicy: Never
          containers:
            - name: nightly-report
              image: ghcr.io/acme/checkout:1.4.2
              env:
                - name: LOG_LEVEL
                  value: info
