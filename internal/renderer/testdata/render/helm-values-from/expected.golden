---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:eab93cfe641f7bc1221d1fed8245114c56e76771e2934e2f9a21c453c4196a77
    kelson.dev/namespace-ownership: declared
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: checkout-production-mailer
  namespace: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: mailer
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:0ffde9493ec15f2ca27e92e02c85f0d6195751195880a58d68b55eccba35326d
spec:
  interval: 1h
  url: https://charts.acme.example
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: checkout-production-mailer
  namespace: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: mailer
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:0ffde9493ec15f2ca27e92e02c85f0d6195751195880a58d68b55eccba35326d
spec:
  interval: 10m
  chart:
    spec:
      chart: mailer
      version: 2.0.1
      sourceRef:
        kind: HelmRepository
        name: checkout-production-mailer
  targetNamespace: checkout-production
  valuesFrom:
    - kind: ConfigMap
      name: mailer-defaults
    - kind: Secret
      name: mailer-smtp-credentials
  values:
    replicaCount: 1
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: worker
  namespace: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a82c307e45e8dcba3b12100dc806530080d526a0103140467e3c27b0d8c7320a
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: checkout-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a82c307e45e8dcba3b12100dc806530080d526a0103140467e3c27b0d8c7320a
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/application: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: worker
        kelson.dev/environment: production
        kelson.dev/project: checkout
    spec:
      serviceAccountName: worker
      containers:
        - name: worker
          image: ghcr.io/acme/checkout:1.4.2
          command:
            - bundle
            - exec
            - sidekiq
