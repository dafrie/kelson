---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:390d1e9fdf0a284bf9a6450928bd721e42fd79c0d49742a8a0246aa4effe0313
    kelson.dev/namespace-ownership: declared
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cache-auth
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a68d1bdb82058402447d5f4283e47034afa9d29ef3791ac57148251ca7783253
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: team-vault
    kind: SecretStore
  target:
    name: cache-auth
    creationPolicy: Owner
  data:
    - secretKey: password
      remoteRef:
        key: cache-auth
        property: password
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: mail-relay
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:46e0d4dbf7596401dca4aa73f1ff01ccf464e14b0674334b6b613f0f667d1fa6
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: team-vault
    kind: SecretStore
  target:
    name: mail-relay
    creationPolicy: Owner
  data:
    - secretKey: password
      remoteRef:
        key: mail-relay
        property: password
---
apiVersion: valkey.io/v1alpha1
kind: ValkeyCluster
metadata:
  name: checkout-staging-cache
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:cec82ea96035b2d9252ea03e3b15cf4f2a071a8f13e39e18cab8125576b82007
spec:
  shards: 1
  replicas: 0
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      memory: 512Mi
  users:
    - name: default
      passwordSecret:
        name: cache-auth
        keys:
          - password
      keys:
        readWrite:
          - '*'
      channels:
        patterns:
          - '*'
      commands:
        allow:
          - '@all'
  config:
    maxmemory: 384mb
    maxmemory-policy: allkeys-lru
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: worker
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:ab950439c0ff0e6e8aa5ee1a28f91e683c55f0a32f7a47d7a84f9bee45aa5f91
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:ab950439c0ff0e6e8aa5ee1a28f91e683c55f0a32f7a47d7a84f9bee45aa5f91
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: worker
        kelson.dev/environment: staging
        kelson.dev/project: checkout
    spec:
      serviceAccountName: worker
      containers:
        - name: worker
          image: ghcr.io/acme/checkout:1.4.2
          command:
            - bundle
            - exec
            - sidekiq
          env:
            - name: CACHE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cache-auth
                  key: password
            - name: CACHE_URL
              value: redis://valkey-checkout-staging-cache.checkout-staging.svc:6379
            - name: SMTP_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mail-relay
                  key: password
