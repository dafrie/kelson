---
apiVersion: v1
kind: Namespace
metadata:
  name: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:459efca4f7b11be6fe9ba102540cfa95a203ef8c272aea9861bd338aa8e8ba95
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:7e5e1c340260127fdc0314a288472054711b6f22d78b758d379c089d4a7d4c2e
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:7e5e1c340260127fdc0314a288472054711b6f22d78b758d379c089d4a7d4c2e
spec:
  selector:
    kelson.dev/project: shopfront
    kelson.dev/application: web
  ports:
    - name: http
      port: 3000
      targetPort: 3000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:7e5e1c340260127fdc0314a288472054711b6f22d78b758d379c089d4a7d4c2e
spec:
  replicas: 3
  selector:
    matchLabels:
      kelson.dev/project: shopfront
      kelson.dev/application: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: web
        kelson.dev/environment: production
        kelson.dev/project: shopfront
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: registry.acme.run/shopfront:3.1.0
          ports:
            - name: http
              containerPort: 3000
          env:
            - name: CACHE_URL
              valueFrom:
                secretKeyRef:
                  name: shopfront-cache-credentials
                  key: uri
          resources:
            requests:
              cpu: 250m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 512Mi
          livenessProbe:
            httpGet:
              path: /up
              port: 3000
          readinessProbe:
            httpGet:
              path: /up
              port: 3000
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: web
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:7e5e1c340260127fdc0314a288472054711b6f22d78b758d379c089d4a7d4c2e
spec:
  parentRefs:
    - name: public
  hostnames:
    - web.shop.acme.io
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: web
          port: 3000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: images
  namespace: shopfront
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: images
    kelson.dev/environment: production
    kelson.dev/project: shopfront
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:4684e77535f58b27f546aa007f27a373da450c9846de6a1f157996dda3fd198f
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: shopfront
      kelson.dev/application: images
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: images
        kelson.dev/environment: production
        kelson.dev/project: shopfront
    spec:
      containers:
        - name: images
          image: registry.acme.run/shopfront:3.1.0
          command:
            - shopfront
            - process-images
          env:
            - name: CACHE_URL
              valueFrom:
                secretKeyRef:
                  name: shopfront-cache-credentials
                  key: uri
