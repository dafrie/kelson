---
apiVersion: v1
kind: Namespace
metadata:
  name: shop-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:513f178b98620b9189420d88d6b22a1e534a67ba88fb7d34dd8247a24d8fad0f
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: shop-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:f9507b040b836ce6ac6fd6f228d2bd37e5c46758db44a672b353ba5cefcb8f89
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: shop-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:f9507b040b836ce6ac6fd6f228d2bd37e5c46758db44a672b353ba5cefcb8f89
spec:
  selector:
    kelson.dev/project: shop
    kelson.dev/component: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: shop-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: production
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:f9507b040b836ce6ac6fd6f228d2bd37e5c46758db44a672b353ba5cefcb8f89
spec:
  replicas: 3
  selector:
    matchLabels:
      kelson.dev/project: shop
      kelson.dev/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: web
        kelson.dev/environment: production
        kelson.dev/project: shop
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/shop@sha256:1c3ba5f0e6d94a7182b0c5e4d3f6a8b9c0d1e2f3a4b5c6d7e8f90a1b2c3d4e5f
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: LOG_LEVEL
              value: info
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: worker
  namespace: shop-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: production
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:612f1dc07890639f72a390f7591ce46ebf08d2a69aff76920cba134c76f8c586
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: shop-production
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: production
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:612f1dc07890639f72a390f7591ce46ebf08d2a69aff76920cba134c76f8c586
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: shop
      kelson.dev/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: worker
        kelson.dev/environment: production
        kelson.dev/project: shop
    spec:
      serviceAccountName: worker
      containers:
        - name: worker
          image: ghcr.io/acme/shop:2.4.0
          command:
            - shop
            - work
          env:
            - name: LOG_LEVEL
              value: info
