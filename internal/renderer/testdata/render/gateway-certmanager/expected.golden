---
apiVersion: v1
kind: Namespace
metadata:
  name: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:84f6393d01372945a0710db65b98ccbff1e45f6ed44e7ee65e56b75f91b5ecab
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bcf9d8958f799aed0f79117f810f3ffce5e7b6a024effee49da0b2926e29a8be
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bcf9d8958f799aed0f79117f810f3ffce5e7b6a024effee49da0b2926e29a8be
spec:
  selector:
    kelson.dev/project: hello
    kelson.dev/application: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bcf9d8958f799aed0f79117f810f3ffce5e7b6a024effee49da0b2926e29a8be
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: hello
      kelson.dev/application: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: web
        kelson.dev/environment: staging
        kelson.dev/project: hello
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/hello:v1
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: GREETING
              value: hello
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: web
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bcf9d8958f799aed0f79117f810f3ffce5e7b6a024effee49da0b2926e29a8be
spec:
  parentRefs:
    - name: envoy
  hostnames:
    - web.staging.acme.run
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: web
          port: 8080
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: web-tls
  namespace: hello-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: hello
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bcf9d8958f799aed0f79117f810f3ffce5e7b6a024effee49da0b2926e29a8be
spec:
  secretName: web-tls
  issuerRef:
    kind: ClusterIssuer
    name: letsencrypt-prod
  dnsNames:
    - web.staging.acme.run
