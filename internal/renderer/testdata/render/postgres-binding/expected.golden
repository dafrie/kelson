---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:390d1e9fdf0a284bf9a6450928bd721e42fd79c0d49742a8a0246aa4effe0313
    kelson.dev/namespace-ownership: declared
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: checkout-staging-db
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:994be2ebf7ae97bed94df134ba8e490c3cd3db9519f9087a06a81bb748be53ba
spec:
  instances: 1
  storage:
    size: 5Gi
  resources:
    requests:
      cpu: 500m
      memory: 1Gi
    limits:
      memory: 1Gi
  bootstrap:
    initdb:
      database: app
      owner: app
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:601d3b44594d2f8bab5673e290d8804771ce4d13d3ace23d34fc2f2248ccda81
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:601d3b44594d2f8bab5673e290d8804771ce4d13d3ace23d34fc2f2248ccda81
spec:
  selector:
    kelson.dev/project: checkout
    kelson.dev/application: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:601d3b44594d2f8bab5673e290d8804771ce4d13d3ace23d34fc2f2248ccda81
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/application: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: web
        kelson.dev/environment: staging
        kelson.dev/project: checkout
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/checkout:1.4.2
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: checkout-staging-db-app
                  key: uri
            - name: LOG_LEVEL
              value: info
            - name: PGDATABASE
              valueFrom:
                secretKeyRef:
                  name: checkout-staging-db-app
                  key: dbname
            - name: PGHOST
              valueFrom:
                secretKeyRef:
                  name: checkout-staging-db-app
                  key: host
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: checkout-staging-db-app
                  key: password
            - name: PGPORT
              valueFrom:
                secretKeyRef:
                  name: checkout-staging-db-app
                  key: port
            - name: PGUSER
              valueFrom:
                secretKeyRef:
                  name: checkout-staging-db-app
                  key: username
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:0457cbe6e223998777c0d527baf28d7fa6556b7903ffe3fb3276938173e8053c
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/application: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: worker
        kelson.dev/environment: staging
        kelson.dev/project: checkout
    spec:
      containers:
        - name: worker
          image: ghcr.io/acme/checkout:1.4.2
          command:
            - bundle
            - exec
            - sidekiq
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: checkout-staging-db-app
                  key: uri
            - name: LOG_LEVEL
              value: info
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: nightly-report
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: nightly-report
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:8415556fcd59d213435c319ec1bbdf9e222b0fb423a9f8241b0cf72fc28f8c68
spec:
  schedule: 0 3 * * *
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/application: nightly-report
            kelson.dev/environment: staging
            kelson.dev/project: checkout
        spec:
          restartPolicy: Never
          containers:
            - name: nightly-report
              image: ghcr.io/acme/checkout:1.4.2
              env:
                - name: DATABASE_URL
                  valueFrom:
                    secretKeyRef:
                      name: checkout-staging-db-app
                      key: uri
                - name: LOG_LEVEL
                  value: info
