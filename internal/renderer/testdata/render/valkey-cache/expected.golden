---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:390d1e9fdf0a284bf9a6450928bd721e42fd79c0d49742a8a0246aa4effe0313
    kelson.dev/namespace-ownership: declared
---
apiVersion: valkey.io/v1alpha1
kind: ValkeyCluster
metadata:
  name: checkout-staging-cache
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:90309856c803d5d3482fa4654d29b56c9fc77060116f72ff2c916ba3d397d1d8
spec:
  shards: 1
  replicas: 0
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      memory: 512Mi
  config:
    maxmemory: 384mb
    maxmemory-policy: allkeys-lru
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: worker
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:c8e3e9b9a1372e5676f7d036282ae9c49f8bd93f76e53749c1939d644c84e46c
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:c8e3e9b9a1372e5676f7d036282ae9c49f8bd93f76e53749c1939d644c84e46c
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/application: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: worker
        kelson.dev/environment: staging
        kelson.dev/project: checkout
    spec:
      serviceAccountName: worker
      containers:
        - name: worker
          image: ghcr.io/acme/checkout:1.4.2
          command:
            - bundle
            - exec
            - sidekiq
