---
apiVersion: v1
kind: Namespace
metadata:
  name: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:25678253b0a562e792d329901cef96051b84c9059ea38e2702553aabf972083b
    kelson.dev/namespace-ownership: declared
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:bb1f143e5f6419fc223f9b4789e1936cae5e856f9c06907812bb493f2ad11e30
spec:
  replicas: 2
  selector:
    matchLabels:
      kelson.dev/project: mailroom
      kelson.dev/application: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: worker
        kelson.dev/environment: production
        kelson.dev/project: mailroom
    spec:
      containers:
        - name: worker
          image: registry.acme.run/mailroom:2.0.7
          command:
            - mailroom
            - work
          env:
            - name: QUEUE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mailroom-queue-credentials
                  key: password
            - name: QUEUE_URL
              valueFrom:
                secretKeyRef:
                  name: mailroom-queue-credentials
                  key: uri
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: digest
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: digest
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:6dfd149af26050966f623c495277e3c283e1d0590dc5e5e2130f84f693006f33
spec:
  schedule: 30 6 * * 1-5
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/application: digest
            kelson.dev/environment: production
            kelson.dev/project: mailroom
        spec:
          restartPolicy: Never
          containers:
            - name: digest
              image: registry.acme.run/mailroom:2.0.7
              command:
                - mailroom
                - send-digests
              env:
                - name: QUEUE_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: mailroom-queue-credentials
                      key: password
                - name: QUEUE_URL
                  valueFrom:
                    secretKeyRef:
                      name: mailroom-queue-credentials
                      key: uri
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: retention-sweep
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: retention-sweep
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:fd5da848656a5c861ea77b1d56cc038a82a7bad6438c1920633e829d8d97d6e1
spec:
  schedule: 15 2 * * *
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/application: retention-sweep
            kelson.dev/environment: production
            kelson.dev/project: mailroom
        spec:
          restartPolicy: Never
          containers:
            - name: retention-sweep
              image: registry.acme.run/mailroom:2.0.7
              command:
                - mailroom
                - sweep
                - --older-than=90d
              env:
                - name: QUEUE_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: mailroom-queue-credentials
                      key: password
                - name: QUEUE_URL
                  valueFrom:
                    secretKeyRef:
                      name: mailroom-queue-credentials
                      key: uri
