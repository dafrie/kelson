{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelson.dev/model/environment.schema.json",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "Project",
        "Environment"
      ]
    },
    "metadata": {
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "DNS-1123 label"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "spec": {
      "properties": {
        "project": {
          "type": "string"
        },
        "cluster": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "routing": {
          "properties": {
            "domainSuffix": {
              "type": "string"
            },
            "gatewayClass": {
              "type": "string"
            },
            "tls": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "delivery": {
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "direct",
                "flux",
                "argocd"
              ]
            },
            "git": {
              "properties": {
                "repo": {
                  "type": "string",
                  "description": "git URL of the deployment repository"
                },
                "branch": {
                  "type": "string",
                  "default": "main"
                },
                "path": {
                  "type": "string",
                  "description": "directory within the repo for rendered manifests"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "repo"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "mode"
          ]
        },
        "policy": {
          "properties": {
            "agents": {
              "type": "string",
              "enum": [
                "allow",
                "propose-only"
              ],
              "default": "propose-only"
            },
            "require": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "guards that must hold before deploy; only dry-run is defined"
            },
            "deployers": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "secrets": {
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "cluster",
                "externalSecrets",
                "sops"
              ]
            },
            "store": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "backend"
          ]
        },
        "applications": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "replicas": {
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "min"
                ]
              },
              "resources": {
                "properties": {
                  "requests": {
                    "properties": {
                      "cpu": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      },
                      "memory": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      }
                    },
                    "additionalProperties": false,
                    "type": "object"
                  },
                  "limits": {
                    "properties": {
                      "cpu": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      },
                      "memory": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      }
                    },
                    "additionalProperties": false,
                    "type": "object"
                  }
                },
                "additionalProperties": false,
                "type": "object"
              },
              "env": {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "properties": {
                        "from": {
                          "properties": {
                            "service": {
                              "type": "string",
                              "description": "name of a service declared in the Project"
                            },
                            "key": {
                              "type": "string",
                              "description": "well-known key of the service type"
                            }
                          },
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "service",
                            "key"
                          ]
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "from"
                      ]
                    }
                  ]
                },
                "type": "object"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name"
            ]
          },
          "type": "array"
        },
        "services": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "preset": {
                "type": "string",
                "enum": [
                  "shared",
                  "small",
                  "ha-small",
                  "ha-medium",
                  "branch"
                ]
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "preset"
            ]
          },
          "type": "array"
        },
        "overlays": {
          "items": {
            "properties": {
              "patch": {
                "type": "string",
                "description": "YAML document merged into the resource it targets"
              },
              "manifest": {
                "type": "string",
                "description": "path to an extra Kubernetes manifest"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "project"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
