---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:390d1e9fdf0a284bf9a6450928bd721e42fd79c0d49742a8a0246aa4effe0313
    kelson.dev/namespace-ownership: declared
---
apiVersion: valkey.io/v1alpha1
kind: ValkeyCluster
metadata:
  name: checkout-staging-cache
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:cec82ea96035b2d9252ea03e3b15cf4f2a071a8f13e39e18cab8125576b82007
spec:
  shards: 1
  replicas: 0
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      memory: 512Mi
  users:
    - name: default
      passwordSecret:
        name: cache-auth
        keys:
          - password
      keys:
        readWrite:
          - '*'
      channels:
        patterns:
          - '*'
      commands:
        allow:
          - '@all'
  config:
    maxmemory: 384mb
    maxmemory-policy: allkeys-lru
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: worker
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:9975145efd190ae43deb1c582607d23f59149236b0789ffa87a3a6b4658c42ba
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:9975145efd190ae43deb1c582607d23f59149236b0789ffa87a3a6b4658c42ba
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: worker
        kelson.dev/environment: staging
        kelson.dev/project: checkout
    spec:
      serviceAccountName: worker
      containers:
        - name: worker
          image: ghcr.io/acme/checkout:1.4.2
          command:
            - bundle
            - exec
            - sidekiq
          env:
            - name: CACHE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cache-auth
                  key: password
            - name: CACHE_URL
              value: redis://valkey-checkout-staging-cache.checkout-staging.svc:6379
