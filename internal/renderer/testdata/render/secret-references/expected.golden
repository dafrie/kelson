---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:390d1e9fdf0a284bf9a6450928bd721e42fd79c0d49742a8a0246aa4effe0313
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:c39373ad13afa8999a00f093116da3b9528a0a37ccbb692a040482c4401a35ee
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:c39373ad13afa8999a00f093116da3b9528a0a37ccbb692a040482c4401a35ee
spec:
  selector:
    kelson.dev/project: checkout
    kelson.dev/component: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:c39373ad13afa8999a00f093116da3b9528a0a37ccbb692a040482c4401a35ee
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: web
        kelson.dev/environment: staging
        kelson.dev/project: checkout
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/checkout:1.4.2
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: checkout-db
                  key: url
            - name: FEATURE_FLAGS
              value: checkout-v2,fast-refund
            - name: LOG_LEVEL
              value: info
            - name: SESSION_PEPPER
              valueFrom:
                secretKeyRef:
                  name: payments
                  key: session.pepper
            - name: STRIPE_API_KEY
              valueFrom:
                secretKeyRef:
                  name: payments
                  key: stripe-api-key
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: nightly-report
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: nightly-report
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:b2758f951841951f11e8754a8cd3ff803813dec318701590b8e9a469addeaff6
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: nightly-report
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: nightly-report
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:b2758f951841951f11e8754a8cd3ff803813dec318701590b8e9a469addeaff6
spec:
  schedule: 0 3 * * *
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/component: nightly-report
            kelson.dev/environment: staging
            kelson.dev/project: checkout
        spec:
          serviceAccountName: nightly-report
          restartPolicy: Never
          containers:
            - name: nightly-report
              image: ghcr.io/acme/checkout:1.4.2
              command:
                - checkout
                - report
              env:
                - name: DATABASE_URL
                  valueFrom:
                    secretKeyRef:
                      name: checkout-db
                      key: url
                - name: LOG_LEVEL
                  value: info
                - name: REPORT_BUCKET
                  value: s3://acme-reports
                - name: SMTP_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: mail-relay
                      key: password
