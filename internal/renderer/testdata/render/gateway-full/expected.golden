---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:63d694e731f07cbc7a7a9b49755cc24854ff04cab16e6662e80f18ca0b9709a8
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d00fd5e09ce327b0207f0d08d6545f6e92c6f9ef62276a17c46d67ebae5af9d3
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d00fd5e09ce327b0207f0d08d6545f6e92c6f9ef62276a17c46d67ebae5af9d3
spec:
  selector:
    kelson.dev/project: checkout
    kelson.dev/application: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d00fd5e09ce327b0207f0d08d6545f6e92c6f9ef62276a17c46d67ebae5af9d3
spec:
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/application: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: web
        kelson.dev/environment: production
        kelson.dev/project: checkout
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/checkout:1.4.2
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: checkout-db-credentials
                  key: uri
            - name: LOG_LEVEL
              value: warning
          resources:
            requests:
              cpu: 500m
              memory: 512Mi
            limits:
              memory: 1Gi
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d00fd5e09ce327b0207f0d08d6545f6e92c6f9ef62276a17c46d67ebae5af9d3
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: web
  minReplicas: 3
  maxReplicas: 20
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 80
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d00fd5e09ce327b0207f0d08d6545f6e92c6f9ef62276a17c46d67ebae5af9d3
spec:
  parentRefs:
    - name: envoy
  hostnames:
    - checkout.acme.com
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: web
          port: 8080
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: web-tls
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d00fd5e09ce327b0207f0d08d6545f6e92c6f9ef62276a17c46d67ebae5af9d3
spec:
  secretName: web-tls
  issuerRef:
    kind: ClusterIssuer
    name: letsencrypt-prod
  dnsNames:
    - checkout.acme.com
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: web
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d00fd5e09ce327b0207f0d08d6545f6e92c6f9ef62276a17c46d67ebae5af9d3
spec:
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/application: web
  endpoints:
    - port: http
      path: /metrics
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:e955523524c183ceaaf2e2273f8b58235c21ff381a7c27046eb1f948d32f14ba
spec:
  replicas: 2
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/application: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: worker
        kelson.dev/environment: production
        kelson.dev/project: checkout
    spec:
      containers:
        - name: worker
          image: ghcr.io/acme/checkout:1.4.2
          command:
            - bundle
            - exec
            - sidekiq
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: checkout-db-credentials
                  key: uri
            - name: LOG_LEVEL
              value: info
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: nightly-report
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: nightly-report
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:e5bc09ae32d4d13c79cae9dc2cf9bfbbe65eb37b021ca28b46352ff9452261a6
spec:
  schedule: 0 3 * * *
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/application: nightly-report
            kelson.dev/environment: production
            kelson.dev/project: checkout
        spec:
          restartPolicy: Never
          containers:
            - name: nightly-report
              image: ghcr.io/acme/checkout:1.4.2
              env:
                - name: DATABASE_URL
                  valueFrom:
                    secretKeyRef:
                      name: checkout-db-credentials
                      key: uri
                - name: LOG_LEVEL
                  value: info
