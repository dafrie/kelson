{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelson.dev/model/project.schema.json",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "Project",
        "Environment",
        "GitConnection",
        "GitSource"
      ]
    },
    "metadata": {
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "DNS-1123 label"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "spec": {
      "properties": {
        "source": {
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "description": "DNS-1123 label a component binds to; required in spec.sources and refused on the singular spec.source"
            },
            "git": {
              "type": "string",
              "format": "uri",
              "description": "git URL of the application source"
            },
            "ref": {
              "type": "string",
              "default": "main"
            },
            "connection": {
              "type": "string",
              "description": "name of the GitConnection to authenticate with; resolved by host match against the instance's connections when omitted"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "git"
          ]
        },
        "sources": {
          "items": {
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "description": "DNS-1123 label a component binds to; required in spec.sources and refused on the singular spec.source"
              },
              "git": {
                "type": "string",
                "format": "uri",
                "description": "git URL of the application source"
              },
              "ref": {
                "type": "string",
                "default": "main"
              },
              "connection": {
                "type": "string",
                "description": "name of the GitConnection to authenticate with; resolved by host match against the instance's connections when omitted"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "git"
            ]
          },
          "type": "array",
          "description": "repositories this Project declares for its components to build from; the singular source: is shorthand for one entry named default"
        },
        "build": {
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "auto",
                "dockerfile",
                "buildpacks",
                "none"
              ],
              "default": "auto"
            },
            "dockerfile": {
              "type": "string"
            },
            "by": {
              "type": "string",
              "enum": [
                "kelson",
                "ci"
              ],
              "description": "who produces this project's images; kelson builds them in its own build plane and ci reports images its pipeline already built",
              "default": "kelson"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "image": {
          "type": "string",
          "description": "pre-built image reference"
        },
        "env": {
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "properties": {
                  "from": {
                    "properties": {
                      "service": {
                        "type": "string",
                        "description": "name of a data component (kind postgres or valkey) declared in the Project"
                      },
                      "key": {
                        "type": "string",
                        "description": "well-known key of the service type"
                      }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "service",
                      "key"
                    ]
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "from"
                ]
              },
              {
                "properties": {
                  "secret": {
                    "type": "string",
                    "description": "name of a Secret in the environment's namespace; kelson references it and never creates or reads it"
                  },
                  "key": {
                    "type": "string",
                    "description": "key within that Secret"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "secret",
                  "key"
                ]
              }
            ]
          },
          "type": "object"
        },
        "components": {
          "items": {
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "service",
                  "worker",
                  "cron",
                  "agent",
                  "postgres",
                  "valkey",
                  "helm"
                ],
                "description": "derived from port/schedule when omitted; required for postgres and valkey and helm"
              },
              "image": {
                "type": "string",
                "description": "overrides the Project image (rule P3)"
              },
              "command": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "description": "container command; wins over the image default"
              },
              "port": {
                "type": "integer",
                "maximum": 65535,
                "minimum": 1
              },
              "health": {
                "type": "string",
                "description": "HTTP liveness/readiness path"
              },
              "schedule": {
                "type": "string",
                "description": "five-field cron expression"
              },
              "domains": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "replicas": {
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "min"
                ]
              },
              "resources": {
                "properties": {
                  "requests": {
                    "properties": {
                      "cpu": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      },
                      "memory": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      }
                    },
                    "additionalProperties": false,
                    "type": "object"
                  },
                  "limits": {
                    "properties": {
                      "cpu": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      },
                      "memory": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      }
                    },
                    "additionalProperties": false,
                    "type": "object"
                  }
                },
                "additionalProperties": false,
                "type": "object"
              },
              "env": {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "properties": {
                        "from": {
                          "properties": {
                            "service": {
                              "type": "string",
                              "description": "name of a data component (kind postgres or valkey) declared in the Project"
                            },
                            "key": {
                              "type": "string",
                              "description": "well-known key of the service type"
                            }
                          },
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "service",
                            "key"
                          ]
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "from"
                      ]
                    },
                    {
                      "properties": {
                        "secret": {
                          "type": "string",
                          "description": "name of a Secret in the environment's namespace; kelson references it and never creates or reads it"
                        },
                        "key": {
                          "type": "string",
                          "description": "key within that Secret"
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "secret",
                        "key"
                      ]
                    }
                  ]
                },
                "type": "object"
              },
              "preset": {
                "type": "string",
                "enum": [
                  "shared",
                  "small",
                  "ha-small",
                  "ha-medium",
                  "branch"
                ],
                "description": "data components only",
                "default": "shared"
              },
              "auth": {
                "properties": {
                  "secret": {
                    "type": "string",
                    "description": "name of a Secret in the environment's namespace; kelson references it and never creates or reads it"
                  },
                  "key": {
                    "type": "string",
                    "description": "key within that Secret"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "secret",
                  "key"
                ],
                "description": "valkey components only; names the Secret holding the cache password — kelson references it and never creates or reads it"
              },
              "chart": {
                "type": "string",
                "description": "helm components only; the chart name within its source"
              },
              "chartVersion": {
                "type": "string",
                "description": "helm components only; the exact chart version — required because an unpinned chart is not reproducible"
              },
              "source": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 63,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                    "description": "the name of a source this component builds from, declared in spec.sources or by a GitSource"
                  },
                  {
                    "properties": {
                      "repository": {
                        "type": "string",
                        "format": "uri",
                        "description": "classic Helm repository URL — the one serving index.yaml"
                      },
                      "oci": {
                        "type": "string",
                        "description": "OCI registry URL holding the chart — the registry path without the chart name (oci://ghcr.io/acme/charts)"
                      }
                    },
                    "additionalProperties": false,
                    "type": "object"
                  }
                ],
                "description": "a source name for a buildable component (ADR-0035) or the chart source of a helm component — exactly one of repository or oci (ADR-0016)"
              },
              "values": {
                "type": "object",
                "description": "helm components only; chart values rendered verbatim into the HelmRelease — plain configuration only and never secret material (put that in valuesFrom)"
              },
              "valuesFrom": {
                "items": {
                  "properties": {
                    "secretRef": {
                      "type": "string",
                      "description": "name of a Secret in the environment namespace"
                    },
                    "configMapRef": {
                      "type": "string",
                      "description": "name of a ConfigMap in the environment namespace"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object"
                },
                "type": "array",
                "description": "helm components only; Secrets and ConfigMaps merged into the chart values by helm-controller"
              },
              "release": {
                "properties": {
                  "command": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array",
                    "minItems": 1,
                    "description": "argv of the command; it runs with the component's image and environment"
                  },
                  "timeout": {
                    "type": "string",
                    "description": "Go duration such as 30m; the Job's activeDeadlineSeconds",
                    "default": "10m"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "command"
                ],
                "description": "command run to completion before this revision's workloads roll; refused until issue #227"
              },
              "tools": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "description": "agent components only; refused until issue #75"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name"
            ]
          },
          "type": "array",
          "minItems": 1
        },
        "defaults": {
          "properties": {
            "policy": {
              "properties": {
                "agents": {
                  "type": "string",
                  "enum": [
                    "allow",
                    "propose-only"
                  ],
                  "description": "what an agent may do here unsupervised; propose-only refuses every live mutation",
                  "default": "allow"
                },
                "require": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "guards that must hold before an agent deploy; only dry-run is defined"
                },
                "maxReplicas": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "agents only; the highest replica count an agent may deploy in this environment"
                },
                "protect": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "agents only; components an agent may not delete or scale to zero"
                },
                "forbid": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "agents only; operations refused to agents here — one of deploy / rollback / promote / build / secret-set / secret-delete / spec-write / spec-delete"
                },
                "deployers": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "additionalProperties": false,
              "type": "object"
            },
            "secrets": {
              "properties": {
                "backend": {
                  "type": "string",
                  "enum": [
                    "cluster",
                    "externalSecrets",
                    "sops"
                  ]
                },
                "store": {
                  "type": "string",
                  "description": "externalSecrets only; name of a SecretStore in this namespace or a ClusterSecretStore — optional when the cluster offers exactly one"
                },
                "refreshInterval": {
                  "type": "string",
                  "description": "externalSecrets only; how often the value is re-read from the backing store; a positive Go duration such as 30s or 15m or 1h",
                  "default": "1h"
                },
                "ageRecipients": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "sops only; age public keys (age1…) that encrypted secrets are readable by — required for backend sops"
                },
                "ageKeySecret": {
                  "type": "string",
                  "description": "sops only; name of the Secret holding the age identity — created by the operator in the Kustomization's namespace",
                  "default": "sops-age"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "backend"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "overlays": {
          "items": {
            "properties": {
              "patch": {
                "type": "string",
                "description": "YAML document merged into the resource it targets"
              },
              "manifest": {
                "type": "string",
                "description": "path to an extra Kubernetes manifest"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "components"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
