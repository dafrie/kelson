---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:390d1e9fdf0a284bf9a6450928bd721e42fd79c0d49742a8a0246aa4effe0313
    kelson.dev/namespace-ownership: declared
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: checkout-db
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:6b44bde164fadaa2cfcf1e6e7bc6d0dca6aa6f1c8ac2e39b1f0b23a0c43cdced
spec:
  refreshInterval: 15m
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: checkout-db
    creationPolicy: Owner
  data:
    - secretKey: url
      remoteRef:
        key: checkout-db
        property: url
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: mail-relay
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a61d104e93a54a1741b0dab507c806e06222c146dfb04e2ea3e5f0d317c8709d
spec:
  refreshInterval: 15m
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: mail-relay
    creationPolicy: Owner
  data:
    - secretKey: password
      remoteRef:
        key: mail-relay
        property: password
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: payments
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:137b2d0490157260acb4a30cb4c2214ddd91ed7fe149af2ea24b480b8f0e4f39
spec:
  refreshInterval: 15m
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: payments
    creationPolicy: Owner
  data:
    - secretKey: session.pepper
      remoteRef:
        key: payments
        property: session.pepper
    - secretKey: stripe-api-key
      remoteRef:
        key: payments
        property: stripe-api-key
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:9f9c59bc0b2a8c27feb5c5492cb839fefc45f90c9f7aa43de0f99441ca62d5f6
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:9f9c59bc0b2a8c27feb5c5492cb839fefc45f90c9f7aa43de0f99441ca62d5f6
spec:
  selector:
    kelson.dev/project: checkout
    kelson.dev/application: web
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: web
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:9f9c59bc0b2a8c27feb5c5492cb839fefc45f90c9f7aa43de0f99441ca62d5f6
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/application: web
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: web
        kelson.dev/environment: staging
        kelson.dev/project: checkout
    spec:
      serviceAccountName: web
      containers:
        - name: web
          image: ghcr.io/acme/checkout:1.4.2
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: checkout-db
                  key: url
            - name: FEATURE_FLAGS
              value: checkout-v2,fast-refund
            - name: LOG_LEVEL
              value: info
            - name: SESSION_PEPPER
              valueFrom:
                secretKeyRef:
                  name: payments
                  key: session.pepper
            - name: STRIPE_API_KEY
              valueFrom:
                secretKeyRef:
                  name: payments
                  key: stripe-api-key
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: nightly-report
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: nightly-report
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:5689556591d8e742b50a399ab74b86d2bac19f245a829c2f76fa30af297181e3
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: nightly-report
  namespace: checkout-staging
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: nightly-report
    kelson.dev/environment: staging
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:5689556591d8e742b50a399ab74b86d2bac19f245a829c2f76fa30af297181e3
spec:
  schedule: 0 3 * * *
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/application: nightly-report
            kelson.dev/environment: staging
            kelson.dev/project: checkout
        spec:
          serviceAccountName: nightly-report
          restartPolicy: Never
          containers:
            - name: nightly-report
              image: ghcr.io/acme/checkout:1.4.2
              command:
                - checkout
                - report
              env:
                - name: DATABASE_URL
                  valueFrom:
                    secretKeyRef:
                      name: checkout-db
                      key: url
                - name: LOG_LEVEL
                  value: info
                - name: REPORT_BUCKET
                  value: s3://acme-reports
                - name: SMTP_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: mail-relay
                      key: password
