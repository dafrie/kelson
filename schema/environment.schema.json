{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelson.dev/model/environment.schema.json",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "Project",
        "Environment",
        "GitConnection",
        "GitSource"
      ]
    },
    "metadata": {
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "DNS-1123 label"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "spec": {
      "properties": {
        "project": {
          "type": "string"
        },
        "cluster": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "routing": {
          "properties": {
            "domainSuffix": {
              "type": "string"
            },
            "gatewayClass": {
              "type": "string"
            },
            "tls": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "delivery": {
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "direct",
                "flux"
              ]
            },
            "git": {
              "properties": {
                "repo": {
                  "type": "string",
                  "description": "git URL of the deployment repository"
                },
                "branch": {
                  "type": "string",
                  "default": "main"
                },
                "path": {
                  "type": "string",
                  "description": "directory within the repo for rendered manifests"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "repo"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "mode"
          ]
        },
        "policy": {
          "properties": {
            "agents": {
              "type": "string",
              "enum": [
                "allow",
                "propose-only"
              ],
              "description": "what an agent may do here unsupervised; propose-only refuses every live mutation",
              "default": "allow"
            },
            "require": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "guards that must hold before an agent deploy; only dry-run is defined"
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1,
              "description": "agents only; the highest replica count an agent may deploy in this environment"
            },
            "protect": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "agents only; components an agent may not delete or scale to zero"
            },
            "forbid": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "agents only; operations refused to agents here — one of deploy / rollback / promote / build / secret-set / secret-delete / spec-write / spec-delete"
            },
            "deployers": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "secrets": {
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "cluster",
                "externalSecrets",
                "sops"
              ]
            },
            "store": {
              "type": "string",
              "description": "externalSecrets only; name of a SecretStore in this namespace or a ClusterSecretStore — optional when the cluster offers exactly one"
            },
            "refreshInterval": {
              "type": "string",
              "description": "externalSecrets only; how often the value is re-read from the backing store; a positive Go duration such as 30s or 15m or 1h",
              "default": "1h"
            },
            "ageRecipients": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "sops only; age public keys (age1…) that encrypted secrets are readable by — required for backend sops"
            },
            "ageKeySecret": {
              "type": "string",
              "description": "sops only; name of the Secret holding the age identity — created by the operator in the Kustomization's namespace",
              "default": "sops-age"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "backend"
          ]
        },
        "previews": {
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "github",
                "gitlab"
              ],
              "description": "the forge whose change requests become previews"
            },
            "repo": {
              "type": "string",
              "description": "HTTP(S) URL of the source repository whose change requests become previews; not delivery.git.repo"
            },
            "secretRef": {
              "type": "string",
              "description": "name of the Secret holding forge credentials; never a token. Omit it to have kelson materialize one from the git connection covering previews.repo (ADR-0033)"
            },
            "interval": {
              "type": "string",
              "description": "how often the forge is polled for change requests",
              "default": "10m"
            },
            "filter": {
              "properties": {
                "labels": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "only change requests carrying one of these labels become previews"
                },
                "includeBranch": {
                  "type": "string",
                  "description": "regular expression; only matching branches become previews"
                },
                "excludeBranch": {
                  "type": "string",
                  "description": "regular expression; matching branches are excluded"
                },
                "limit": {
                  "type": "integer",
                  "maximum": 10000,
                  "minimum": 1,
                  "description": "maximum number of simultaneous previews",
                  "default": 10
                }
              },
              "additionalProperties": false,
              "type": "object"
            },
            "skip": {
              "properties": {
                "labels": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "description": "pause preview updates while one of these labels is present; a ! prefix inverts the test"
                }
              },
              "additionalProperties": false,
              "type": "object"
            },
            "artifacts": {
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "oci:// URL of the repository holding per-pull-request manifests; no tag"
                },
                "secretRef": {
                  "type": "string",
                  "description": "name of a docker-registry Secret for a private artifact repository"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "repository"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "provider",
            "repo",
            "artifacts"
          ]
        },
        "autoDeploy": {
          "type": "boolean",
          "description": "follow the components' sources — a push to a bound repository re-renders and republishes this environment (ADR-0036)",
          "default": false
        },
        "components": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "image": {
                "type": "string",
                "description": "pins this component's image in this environment only; the promotion primitive (rule P3)"
              },
              "imageTracked": {
                "type": "boolean",
                "description": "workloads only; the image named here is a starting point rather than a hold — tracking may still advance it and the trigger overwrites it on the next push (ADR-0036 decision 5)"
              },
              "replicas": {
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "min"
                ]
              },
              "resources": {
                "properties": {
                  "requests": {
                    "properties": {
                      "cpu": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      },
                      "memory": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      }
                    },
                    "additionalProperties": false,
                    "type": "object"
                  },
                  "limits": {
                    "properties": {
                      "cpu": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      },
                      "memory": {
                        "type": "string",
                        "description": "Kubernetes quantity"
                      }
                    },
                    "additionalProperties": false,
                    "type": "object"
                  }
                },
                "additionalProperties": false,
                "type": "object"
              },
              "env": {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "properties": {
                        "from": {
                          "properties": {
                            "service": {
                              "type": "string",
                              "description": "name of a data component (kind postgres or valkey) declared in the Project"
                            },
                            "key": {
                              "type": "string",
                              "description": "well-known key of the service type"
                            }
                          },
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "service",
                            "key"
                          ]
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "from"
                      ]
                    },
                    {
                      "properties": {
                        "secret": {
                          "type": "string",
                          "description": "name of a Secret in the environment's namespace; kelson references it and never creates or reads it"
                        },
                        "key": {
                          "type": "string",
                          "description": "key within that Secret"
                        }
                      },
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "secret",
                        "key"
                      ]
                    }
                  ]
                },
                "type": "object"
              },
              "autoDeploy": {
                "type": "boolean",
                "description": "workloads only; follow this component's source here — it overrides the environment's own setting (ADR-0036)"
              },
              "preset": {
                "type": "string",
                "enum": [
                  "shared",
                  "small",
                  "ha-small",
                  "ha-medium",
                  "branch"
                ],
                "description": "data components only"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name"
            ]
          },
          "type": "array"
        },
        "overlays": {
          "items": {
            "properties": {
              "patch": {
                "type": "string",
                "description": "YAML document merged into the resource it targets"
              },
              "manifest": {
                "type": "string",
                "description": "path to an extra Kubernetes manifest"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "project"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
