---
apiVersion: v1
kind: Namespace
metadata:
  name: streaming
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: streaming
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:bf7ccd00998817353f2ffcc4137a45af9e22ea52c6d021d0b054a3f92d1f1835
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: transcoder
  namespace: streaming
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: transcoder
    kelson.dev/environment: production
    kelson.dev/project: streaming
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a187f61dce5a14c3f8c7ad9437b82e334b934ad1a65f47f1bc1dcd1d7bc51a7b
---
apiVersion: v1
kind: Service
metadata:
  name: transcoder
  namespace: streaming
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: transcoder
    kelson.dev/environment: production
    kelson.dev/project: streaming
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a187f61dce5a14c3f8c7ad9437b82e334b934ad1a65f47f1bc1dcd1d7bc51a7b
spec:
  selector:
    kelson.dev/project: streaming
    kelson.dev/application: transcoder
  ports:
    - name: http
      port: 8443
      targetPort: 8443
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: transcoder
  namespace: streaming
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: transcoder
    kelson.dev/environment: production
    kelson.dev/project: streaming
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a187f61dce5a14c3f8c7ad9437b82e334b934ad1a65f47f1bc1dcd1d7bc51a7b
    kelson.dev/overlays: ./k8s/patches/affinity.yaml
spec:
  selector:
    matchLabels:
      kelson.dev/project: streaming
      kelson.dev/application: transcoder
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: transcoder
        kelson.dev/environment: production
        kelson.dev/project: streaming
    spec:
      serviceAccountName: transcoder
      containers:
        - name: transcoder
          image: ghcr.io/acme/streaming:0.9.1
          ports:
            - name: http
              containerPort: 8443
          resources:
            requests:
              cpu: "4"
              memory: 8Gi
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: acme.com/gpu
                    operator: In
                    values: ["true"]
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: transcoder
  namespace: streaming
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: transcoder
    kelson.dev/environment: production
    kelson.dev/project: streaming
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a187f61dce5a14c3f8c7ad9437b82e334b934ad1a65f47f1bc1dcd1d7bc51a7b
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: transcoder
  minReplicas: 2
  maxReplicas: 8
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 80
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: transcoder
  namespace: streaming
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: transcoder
    kelson.dev/environment: production
    kelson.dev/project: streaming
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a187f61dce5a14c3f8c7ad9437b82e334b934ad1a65f47f1bc1dcd1d7bc51a7b
spec:
  parentRefs:
    - name: envoy
  hostnames:
    - stream.acme.com
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: transcoder
          port: 8443
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: transcoder-tls
  namespace: streaming
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: transcoder
    kelson.dev/environment: production
    kelson.dev/project: streaming
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:a187f61dce5a14c3f8c7ad9437b82e334b934ad1a65f47f1bc1dcd1d7bc51a7b
spec:
  secretName: transcoder-tls
  issuerRef:
    kind: ClusterIssuer
    name: letsencrypt-prod
  dnsNames:
    - stream.acme.com
---
# Extra manifest emitted alongside the rendered resources, as-is.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: transcoder-ingress
  namespace: streaming
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: streaming
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:4aa949392e11d6e385a54cf564ac8d9f6987003c817c3365bbb17ceb797ef68a
    kelson.dev/overlays: ./k8s/extra/networkpolicy.yaml
spec:
  podSelector:
    matchLabels:
      kelson.dev/application: transcoder
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              acme.com/partner: cdn
      ports:
        - port: 8443
