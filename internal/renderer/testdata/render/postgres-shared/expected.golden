---
apiVersion: v1
kind: Namespace
metadata:
  name: shop-development
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: development
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:5fe6f74ae21d3fb943350dde1ec171ca43c4a9034dda741fd04f392dec7352bc
    kelson.dev/namespace-ownership: declared
---
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: shop-development-db
  namespace: kelson-data
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: development
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:40dd09e6f56882cb51c200b5b508bfb4e3776424dfe0800b62ef35357db882b4
spec:
  cluster:
    name: kelson-shared-development
  name: shop-development-db
  owner: shop-development-db
  databaseReclaimPolicy: retain
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: api
  namespace: shop-development
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: api
    kelson.dev/environment: development
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d8d05b94f069c60bace2edd90ea766a1bab6c0160721fdf710ab973ff9a27c1f
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: shop-development
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: api
    kelson.dev/environment: development
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d8d05b94f069c60bace2edd90ea766a1bab6c0160721fdf710ab973ff9a27c1f
spec:
  selector:
    kelson.dev/project: shop
    kelson.dev/application: api
  ports:
    - name: http
      port: 3000
      targetPort: 3000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: shop-development
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: api
    kelson.dev/environment: development
    kelson.dev/project: shop
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:d8d05b94f069c60bace2edd90ea766a1bab6c0160721fdf710ab973ff9a27c1f
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: shop
      kelson.dev/application: api
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: api
        kelson.dev/environment: development
        kelson.dev/project: shop
    spec:
      serviceAccountName: api
      containers:
        - name: api
          image: ghcr.io/acme/shop:3.0.0
          ports:
            - name: http
              containerPort: 3000
