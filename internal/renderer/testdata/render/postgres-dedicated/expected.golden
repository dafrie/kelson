---
apiVersion: v1
kind: Namespace
metadata:
  name: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:63d694e731f07cbc7a7a9b49755cc24854ff04cab16e6662e80f18ca0b9709a8
    kelson.dev/namespace-ownership: declared
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: checkout-production-db
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:cdee0914eabe15b5cd40555c43319ee4f56b5bb121501e9c17b1f7d5786a5cb0
spec:
  instances: 3
  minSyncReplicas: 1
  maxSyncReplicas: 1
  storage:
    size: 5Gi
  resources:
    requests:
      cpu: 500m
      memory: 1Gi
    limits:
      memory: 1Gi
  bootstrap:
    initdb:
      database: app
      owner: app
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: checkout-production-reporting
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:6d3c49a08faad1968dd5c20febb311ae1fb61deca26313f0b6d769f7e409329d
spec:
  instances: 3
  minSyncReplicas: 1
  maxSyncReplicas: 1
  storage:
    size: 20Gi
  resources:
    requests:
      cpu: "2"
      memory: 4Gi
    limits:
      memory: 4Gi
  bootstrap:
    initdb:
      database: app
      owner: app
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: checkout-prod
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/application: worker
    kelson.dev/environment: production
    kelson.dev/project: checkout
  annotations:
    kelson.dev/renderer-version: 0.1.0
    kelson.dev/spec-hash: sha256:8b227f7f10885245824114018f693b851c43c707b8c1cb135c7e530312ff38e2
spec:
  replicas: 1
  selector:
    matchLabels:
      kelson.dev/project: checkout
      kelson.dev/application: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/application: worker
        kelson.dev/environment: production
        kelson.dev/project: checkout
    spec:
      containers:
        - name: worker
          image: ghcr.io/acme/checkout:1.4.2
          command:
            - bundle
            - exec
            - sidekiq
