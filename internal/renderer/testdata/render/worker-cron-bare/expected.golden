---
apiVersion: v1
kind: Namespace
metadata:
  name: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:25678253b0a562e792d329901cef96051b84c9059ea38e2702553aabf972083b
    kelson.dev/namespace-ownership: declared
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: worker
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:34f5b5972e5c9419ea398285ef72d2cc3695a6ed225dd51493c9d0c9ebd52f88
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: worker
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:34f5b5972e5c9419ea398285ef72d2cc3695a6ed225dd51493c9d0c9ebd52f88
spec:
  replicas: 2
  selector:
    matchLabels:
      kelson.dev/project: mailroom
      kelson.dev/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: kelson
        kelson.dev/component: worker
        kelson.dev/environment: production
        kelson.dev/project: mailroom
    spec:
      serviceAccountName: worker
      containers:
        - name: worker
          image: registry.acme.run/mailroom:2.0.7
          command:
            - mailroom
            - work
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: digest
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: digest
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:e34f563767f9c9c2968e307d5e79953b9993b8ba8dafe529905b216e535d93ff
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: digest
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: digest
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:e34f563767f9c9c2968e307d5e79953b9993b8ba8dafe529905b216e535d93ff
spec:
  schedule: 30 6 * * 1-5
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/component: digest
            kelson.dev/environment: production
            kelson.dev/project: mailroom
        spec:
          serviceAccountName: digest
          restartPolicy: Never
          containers:
            - name: digest
              image: registry.acme.run/mailroom:2.0.7
              command:
                - mailroom
                - send-digests
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: retention-sweep
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: retention-sweep
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:d3dfedcde3787e1439ea4065c472a68765ed9d264984cfa3b38d975ff87cc809
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: retention-sweep
  namespace: mailroom
  labels:
    app.kubernetes.io/managed-by: kelson
    kelson.dev/component: retention-sweep
    kelson.dev/environment: production
    kelson.dev/project: mailroom
  annotations:
    kelson.dev/renderer-version: 0.2.0
    kelson.dev/spec-hash: sha256:d3dfedcde3787e1439ea4065c472a68765ed9d264984cfa3b38d975ff87cc809
spec:
  schedule: 15 2 * * *
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/managed-by: kelson
            kelson.dev/component: retention-sweep
            kelson.dev/environment: production
            kelson.dev/project: mailroom
        spec:
          serviceAccountName: retention-sweep
          restartPolicy: Never
          containers:
            - name: retention-sweep
              image: registry.acme.run/mailroom:2.0.7
              command:
                - mailroom
                - sweep
                - --older-than=90d
